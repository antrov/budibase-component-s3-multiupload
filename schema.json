{
  "type": "component",
  "metadata": {},
  "schema": {
    "name": "drop-the-s3",
    "friendlyName": "drop-the-s3",
    "description": "An amazing Budibase component!",
    "icon": "Text",
    "settings": [
      {
        "type": "text",
        "key": "bucket",
        "label": "Bucket"
      },
      {
        "type": "text",
        "key": "prefix",
        "label": "Prefix"
      },
      {
        "type": "event",
        "key": "onFilesDropped",
        "label": "On Files Dropped",
        "context": [
          {
            "label": "Files",
            "key": "files"
          }
        ]
      },
      {
        "type": "event",
        "key": "onUploadStarted",
        "label": "On Upload Started",
        "context": [
          {
            "label": "Filename",
            "key": "filename"
          },
          {
            "label": "UUID",
            "key": "uuid"
          }
        ]
      },
      {
        "type": "event",
        "key": "onUploadSucceded",
        "label": "On Upload Succeded",
        "context": [
          {
            "label": "Filename",
            "key": "filename"
          },
          {
            "label": "UUID",
            "key": "uuid"
          }
        ]
      },
      {
        "type": "event",
        "key": "onUploadFailed",
        "label": "On Upload Failed",
        "context": [
          {
            "label": "Filename",
            "key": "filename"
          },
          {
            "label": "UUID",
            "key": "uuid"
          },
          {
            "label": "Error",
            "key": "error"
          }
        ]
      },
      {
        "type": "dataSource/s3",
        "label": "S3 datasource",
        "key": "datasourceId",
        "info": "This component can't be used with S3 datasources that use custom endpoints"
      }
    ],
    "hasChildren": true,
    "context": [
      {
        "type": "static",
        "values": [
          {
            "label": "Files in Queue",
            "key": "filesInQueue",
            "type": "number",
            "defaultValue": 0
          },
            {
            "label": "Files Uploaded",
            "key": "filesUploaded",
            "type": "number",
            "defaultValue": 0
            },
            {
            "label": "Has Hover",
            "key": "hasHover",
            "type": "boolean",
            "defaultValue": false
            }
        ]
      }
    ]
  }
}